{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aoa-stats/stats/measurement-contract/outcome-receipt.schema.json",
  "title": "OS Abyss active-organ outcome receipt",
  "description": "C10 content-minimized owner-fact receipt for action change, task outcome, costs, harm, confounders, and attribution uncertainty. It is measurement input only and grants no semantic or effect authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contract_id",
    "contract_name",
    "receipt_id",
    "receipt_version",
    "idempotency_key",
    "producer_owner",
    "fact_owner",
    "stats_schema_owner",
    "tenant_id",
    "consumer_id",
    "run_id",
    "task_ref",
    "trigger_ref",
    "anchor_ref",
    "recall_intent_ref",
    "recall_packet_refs",
    "intervention_decision_ref",
    "runtime_delivery_ref",
    "experiment_manifest_ref",
    "model_prompt_provider_hardware_pin_ref",
    "host_observation_refs",
    "experiment_assignment",
    "exact_effect_binding_ref",
    "memory_used",
    "action_before_memory",
    "action_after_memory",
    "terminal_outcome",
    "delayed_outcome_posture",
    "delayed_outcomes",
    "confounders",
    "accidental_success",
    "harm",
    "cost_observations",
    "evaluator",
    "operator_intervention",
    "evaluation_posture",
    "attribution",
    "source_refs",
    "policy_pin",
    "privacy_class",
    "retention_until",
    "validation_status",
    "produced_at",
    "content_digest",
    "raw_content_included",
    "payload_refs_only",
    "semantic_authority",
    "effect_authority",
    "training_use"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "contract_id": {
      "const": "C10"
    },
    "contract_name": {
      "const": "OutcomeReceipt"
    },
    "receipt_id": {
      "type": "string",
      "minLength": 1
    },
    "receipt_version": {
      "type": "integer",
      "minimum": 1
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 1
    },
    "producer_owner": {
      "type": "string",
      "minLength": 1
    },
    "fact_owner": {
      "type": "string",
      "minLength": 1
    },
    "stats_schema_owner": {
      "const": "aoa-stats"
    },
    "tenant_id": {
      "type": "string",
      "minLength": 1
    },
    "consumer_id": {
      "type": "string",
      "minLength": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "task_ref": {
      "$ref": "#/$defs/provenance_ref"
    },
    "trigger_ref": {
      "$ref": "#/$defs/provenance_ref"
    },
    "anchor_ref": {
      "$ref": "#/$defs/provenance_ref"
    },
    "recall_intent_ref": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/provenance_ref"
        }
      ]
    },
    "recall_packet_refs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/provenance_ref"
      }
    },
    "intervention_decision_ref": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/provenance_ref"
        }
      ]
    },
    "runtime_delivery_ref": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/provenance_ref"
        }
      ]
    },
    "experiment_manifest_ref": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/provenance_ref"
        }
      ]
    },
    "model_prompt_provider_hardware_pin_ref": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/provenance_ref"
        }
      ]
    },
    "host_observation_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/provenance_ref"
      }
    },
    "experiment_assignment": {
      "$ref": "#/$defs/experiment_assignment"
    },
    "exact_effect_binding_ref": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/provenance_ref"
        }
      ]
    },
    "memory_used": {
      "enum": [
        true,
        false,
        "unknown"
      ]
    },
    "action_before_memory": {
      "$ref": "#/$defs/action_snapshot"
    },
    "action_after_memory": {
      "$ref": "#/$defs/action_snapshot"
    },
    "terminal_outcome": {
      "$ref": "#/$defs/outcome_observation"
    },
    "delayed_outcome_posture": {
      "enum": [
        "none_expected",
        "pending",
        "observed",
        "overdue",
        "unknown"
      ]
    },
    "delayed_outcomes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/outcome_observation"
      }
    },
    "confounders": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/confounder"
      }
    },
    "accidental_success": {
      "$ref": "#/$defs/accidental_success"
    },
    "harm": {
      "$ref": "#/$defs/harm"
    },
    "cost_observations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/cost_observation"
      }
    },
    "evaluator": {
      "$ref": "#/$defs/evaluator"
    },
    "operator_intervention": {
      "$ref": "#/$defs/operator_intervention"
    },
    "evaluation_posture": {
      "$ref": "#/$defs/evaluation_posture"
    },
    "attribution": {
      "$ref": "#/$defs/attribution"
    },
    "source_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/provenance_ref"
      }
    },
    "policy_pin": {
      "$ref": "#/$defs/policy_pin"
    },
    "privacy_class": {
      "enum": [
        "D0",
        "D1",
        "D2",
        "D3"
      ]
    },
    "retention_until": {
      "type": "string",
      "format": "date-time"
    },
    "validation_status": {
      "enum": [
        "valid",
        "partial",
        "failed",
        "invalid"
      ]
    },
    "produced_at": {
      "type": "string",
      "format": "date-time"
    },
    "content_digest": {
      "$ref": "#/$defs/digest"
    },
    "raw_content_included": {
      "const": false
    },
    "payload_refs_only": {
      "const": true
    },
    "semantic_authority": {
      "const": "none"
    },
    "effect_authority": {
      "const": "none"
    },
    "training_use": {
      "const": "forbidden"
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "provenance_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "owner_repo",
        "artifact_ref",
        "artifact_version",
        "artifact_digest"
      ],
      "properties": {
        "owner_repo": {
          "type": "string",
          "minLength": 1
        },
        "artifact_ref": {
          "type": "string",
          "minLength": 1
        },
        "artifact_version": {
          "type": "string",
          "minLength": 1
        },
        "artifact_digest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "policy_pin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy_id",
        "policy_version",
        "decision_ref",
        "policy_digest"
      ],
      "properties": {
        "policy_id": {
          "type": "string",
          "minLength": 1
        },
        "policy_version": {
          "type": "string",
          "minLength": 1
        },
        "decision_ref": {
          "type": "string",
          "minLength": 1
        },
        "policy_digest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "experiment_assignment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "design",
        "arm_id",
        "assignment_digest",
        "holdout",
        "always_shadow_counterfactual_ref"
      ],
      "properties": {
        "design": {
          "enum": [
            "randomized_holdout",
            "paired",
            "observational",
            "not_assigned"
          ]
        },
        "arm_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "assignment_digest": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/digest"
            }
          ]
        },
        "holdout": {
          "enum": [
            true,
            false,
            "unknown"
          ]
        },
        "always_shadow_counterfactual_ref": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/provenance_ref"
            }
          ]
        }
      }
    },
    "evaluator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evaluator_id",
        "owner_repo",
        "role",
        "evidence_ref"
      ],
      "properties": {
        "evaluator_id": {
          "type": "string",
          "minLength": 1
        },
        "owner_repo": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "enum": [
            "independent_judge",
            "same_model_declared",
            "not_evaluated"
          ]
        },
        "evidence_ref": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/provenance_ref"
            }
          ]
        }
      }
    },
    "operator_intervention": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "occurred",
        "intervention_class",
        "evidence_refs",
        "time_measurement_ref"
      ],
      "properties": {
        "occurred": {
          "enum": [
            true,
            false,
            "unknown"
          ]
        },
        "intervention_class": {
          "enum": [
            "none",
            "correction",
            "approval",
            "execution",
            "measurement",
            "other",
            "unknown"
          ]
        },
        "evidence_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/provenance_ref"
          }
        },
        "time_measurement_ref": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/provenance_ref"
            }
          ]
        }
      }
    },
    "evaluation_posture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "eval_plane_status",
        "independent_judge_ref",
        "reward_hacking_check_ref",
        "fairness_tenant_skew_ref",
        "model_version_stratum_ref",
        "access_count_used_as_utility",
        "policy_update_state",
        "semantic_memory_transition_allowed"
      ],
      "properties": {
        "eval_plane_status": {
          "enum": [
            "available",
            "degraded",
            "unavailable"
          ]
        },
        "independent_judge_ref": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/provenance_ref"
            }
          ]
        },
        "reward_hacking_check_ref": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/provenance_ref"
            }
          ]
        },
        "fairness_tenant_skew_ref": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/provenance_ref"
            }
          ]
        },
        "model_version_stratum_ref": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/provenance_ref"
            }
          ]
        },
        "access_count_used_as_utility": {
          "const": false
        },
        "policy_update_state": {
          "enum": [
            "frozen",
            "proposal_only",
            "not_requested"
          ]
        },
        "semantic_memory_transition_allowed": {
          "const": false
        }
      }
    },
    "action_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phase",
        "observed_at",
        "completeness",
        "decision_state",
        "action_class",
        "target_ref",
        "operation_id",
        "parameters_digest",
        "source_snapshot_ref",
        "approval_ref",
        "rollback_ref",
        "snapshot_digest",
        "raw_content_included"
      ],
      "properties": {
        "phase": {
          "enum": [
            "before_memory",
            "after_memory"
          ]
        },
        "observed_at": {
          "type": "string",
          "format": "date-time"
        },
        "completeness": {
          "enum": [
            "complete",
            "partial",
            "unknown"
          ]
        },
        "decision_state": {
          "enum": [
            "no_action",
            "candidate",
            "selected",
            "attempted",
            "completed",
            "failed",
            "suppressed",
            "unknown"
          ]
        },
        "action_class": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "target_ref": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/provenance_ref"
            }
          ]
        },
        "operation_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "parameters_digest": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/digest"
            }
          ]
        },
        "source_snapshot_ref": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/provenance_ref"
            }
          ]
        },
        "approval_ref": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/provenance_ref"
            }
          ]
        },
        "rollback_ref": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/provenance_ref"
            }
          ]
        },
        "snapshot_digest": {
          "$ref": "#/$defs/digest"
        },
        "raw_content_included": {
          "const": false
        }
      }
    },
    "outcome_observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "outcome_id",
        "kind",
        "state",
        "observed_at",
        "expected_at",
        "owner_fact_ref",
        "task_owner_acceptance",
        "quality_measurement_refs",
        "raw_content_included"
      ],
      "properties": {
        "outcome_id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "terminal",
            "delayed"
          ]
        },
        "state": {
          "enum": [
            "success",
            "failure",
            "partial",
            "no_effect",
            "harm",
            "pending",
            "missed",
            "invalid",
            "unknown"
          ]
        },
        "observed_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "expected_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "owner_fact_ref": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/provenance_ref"
            }
          ]
        },
        "task_owner_acceptance": {
          "enum": [
            true,
            false,
            "unknown"
          ]
        },
        "quality_measurement_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/provenance_ref"
          }
        },
        "raw_content_included": {
          "const": false
        }
      }
    },
    "confounder": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "confounder_id",
        "class",
        "direction",
        "materiality",
        "evidence_refs"
      ],
      "properties": {
        "confounder_id": {
          "type": "string",
          "minLength": 1
        },
        "class": {
          "enum": [
            "concurrent_change",
            "environment",
            "model_variance",
            "human_intervention",
            "data_drift",
            "tool_failure",
            "measurement_gap",
            "selection_bias",
            "carryover",
            "other"
          ]
        },
        "direction": {
          "enum": [
            "could_inflate",
            "could_depress",
            "could_reverse",
            "could_mix",
            "unknown"
          ]
        },
        "materiality": {
          "enum": [
            "possible",
            "likely",
            "known",
            "unknown"
          ]
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/provenance_ref"
          }
        }
      }
    },
    "accidental_success": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "detection_basis",
        "evidence_refs"
      ],
      "properties": {
        "value": {
          "enum": [
            true,
            false,
            "unknown"
          ]
        },
        "detection_basis": {
          "enum": [
            "none",
            "owner_fact",
            "eval_verdict",
            "confounder_analysis",
            "unknown"
          ]
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/provenance_ref"
          }
        }
      }
    },
    "harm": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observed",
        "severity",
        "harm_refs",
        "immediate_stop_triggered"
      ],
      "properties": {
        "observed": {
          "enum": [
            true,
            false,
            "unknown"
          ]
        },
        "severity": {
          "enum": [
            "none",
            "low",
            "medium",
            "high",
            "critical",
            "unknown"
          ]
        },
        "harm_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/provenance_ref"
          }
        },
        "immediate_stop_triggered": {
          "enum": [
            true,
            false,
            "unknown"
          ]
        }
      }
    },
    "cost_observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "measurement_id",
        "category",
        "status",
        "unit",
        "number",
        "sample_size",
        "measurement_packet_ref"
      ],
      "properties": {
        "measurement_id": {
          "type": "string",
          "minLength": 1
        },
        "category": {
          "enum": [
            "latency",
            "tokens",
            "money",
            "energy",
            "operator_time",
            "compute_time",
            "storage",
            "network",
            "other"
          ]
        },
        "status": {
          "enum": [
            "observed",
            "missing",
            "unknown",
            "stale"
          ]
        },
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "number": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "sample_size": {
          "type": "integer",
          "minimum": 0
        },
        "measurement_packet_ref": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/provenance_ref"
            }
          ]
        }
      }
    },
    "attribution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "confidence",
        "basis",
        "eval_verdict_ref",
        "counterfactual_ref",
        "causal_claim"
      ],
      "properties": {
        "status": {
          "enum": [
            "not_evaluated",
            "unknown",
            "possible",
            "supported",
            "contested"
          ]
        },
        "confidence": {
          "enum": [
            "none",
            "low",
            "medium",
            "high",
            "unknown"
          ]
        },
        "basis": {
          "enum": [
            "no_counterfactual",
            "insufficient_snapshots",
            "confounded",
            "accidental_success",
            "harm_signal",
            "paired_evidence",
            "randomized_evidence",
            "owner_verdict_pending",
            "not_applicable",
            "other"
          ]
        },
        "eval_verdict_ref": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/provenance_ref"
            }
          ]
        },
        "counterfactual_ref": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/provenance_ref"
            }
          ]
        },
        "causal_claim": {
          "const": "forbidden"
        }
      }
    }
  }
}
