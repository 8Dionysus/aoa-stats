{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aoa-stats/stats/measurement-contract/inference-economy-observation.schema.json",
  "title": "OS Abyss provider-neutral inference economy observation",
  "description": "An opt-in, content-minimized observation shape for comparing execution economy. It carries no activation, promotion, proof, policy, routing, or owner-acceptance authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contract_version",
    "observation_id",
    "observed_at",
    "source_ref",
    "runtime_ref",
    "observation_status",
    "tokens",
    "activity",
    "tools",
    "wall_time_seconds",
    "runtime_outcome",
    "eval_verdict",
    "closeout",
    "owner_acceptance",
    "provenance",
    "progress",
    "unknown_fields",
    "authority_ceiling"
  ],
  "properties": {
    "schema_version": {
      "const": "aoa_stats_inference_economy_observation_v1"
    },
    "contract_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "observation_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "source_ref": {
      "$ref": "#/$defs/content_ref"
    },
    "runtime_ref": {
      "oneOf": [
        {
          "$ref": "#/$defs/content_ref"
        },
        {
          "type": "null"
        }
      ]
    },
    "observation_status": {
      "enum": ["complete", "partial", "missing", "unknown", "stale"]
    },
    "tokens": {
      "$ref": "#/$defs/token_metrics"
    },
    "activity": {
      "$ref": "#/$defs/activity_metrics"
    },
    "tools": {
      "$ref": "#/$defs/tool_metrics"
    },
    "wall_time_seconds": {
      "$ref": "#/$defs/duration_metric"
    },
    "runtime_outcome": {
      "$ref": "#/$defs/runtime_outcome"
    },
    "eval_verdict": {
      "$ref": "#/$defs/eval_verdict"
    },
    "closeout": {
      "$ref": "#/$defs/closeout"
    },
    "owner_acceptance": {
      "$ref": "#/$defs/owner_acceptance"
    },
    "provenance": {
      "$ref": "#/$defs/provenance"
    },
    "progress": {
      "$ref": "#/$defs/progress"
    },
    "unknown_fields": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "authority_ceiling": {
      "const": "Descriptive provider-neutral execution-economy observations only; they do not authorize activation, promotion, proof, policy, routing, or owner acceptance."
    }
  },
  "$defs": {
    "content_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["object_id", "owner_repo", "schema_version", "digest"],
      "properties": {
        "object_id": {
          "type": "string",
          "minLength": 1
        },
        "owner_repo": {
          "type": "string",
          "minLength": 1
        },
        "schema_version": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "evidence_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "ref"],
      "properties": {
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "ref": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "metric": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "basis",
        "uncertainty",
        "value",
        "evidence_refs",
        "reason"
      ],
      "properties": {
        "status": {
          "enum": ["observed", "missing", "unknown", "stale"]
        },
        "basis": {
          "enum": [
            "provider_reported",
            "exact_tokenizer",
            "estimated",
            "unknown",
            "not_applicable"
          ]
        },
        "uncertainty": {
          "enum": [
            "exact",
            "estimated",
            "not_estimated",
            "not_applicable"
          ]
        },
        "value": {
          "type": ["integer", "number", "null"],
          "minimum": 0
        },
        "evidence_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/evidence_ref"
          }
        },
        "reason": {
          "type": ["string", "null"],
          "minLength": 1
        }
      }
    },
    "count_metric": {
      "allOf": [
        {
          "$ref": "#/$defs/metric"
        },
        {
          "properties": {
            "value": {
              "type": ["integer", "null"],
              "minimum": 0
            }
          }
        }
      ]
    },
    "duration_metric": {
      "allOf": [
        {
          "$ref": "#/$defs/metric"
        },
        {
          "properties": {
            "value": {
              "type": ["number", "null"],
              "minimum": 0
            }
          }
        }
      ]
    },
    "token_metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input", "cached_input", "output"],
      "properties": {
        "input": {
          "$ref": "#/$defs/count_metric"
        },
        "cached_input": {
          "$ref": "#/$defs/count_metric"
        },
        "output": {
          "$ref": "#/$defs/count_metric"
        }
      }
    },
    "activity_metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "turns",
        "model_calls",
        "intermediate_volume",
        "compactions",
        "losses",
        "retries",
        "rework"
      ],
      "properties": {
        "turns": {
          "$ref": "#/$defs/count_metric"
        },
        "model_calls": {
          "$ref": "#/$defs/count_metric"
        },
        "intermediate_volume": {
          "type": "object",
          "additionalProperties": false,
          "required": ["items", "bytes", "tokens"],
          "properties": {
            "items": {
              "$ref": "#/$defs/count_metric"
            },
            "bytes": {
              "$ref": "#/$defs/count_metric"
            },
            "tokens": {
              "$ref": "#/$defs/count_metric"
            }
          }
        },
        "compactions": {
          "$ref": "#/$defs/count_metric"
        },
        "losses": {
          "$ref": "#/$defs/count_metric"
        },
        "retries": {
          "$ref": "#/$defs/count_metric"
        },
        "rework": {
          "$ref": "#/$defs/count_metric"
        }
      }
    },
    "tool_metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_bytes", "schema_tokens", "calls"],
      "properties": {
        "schema_bytes": {
          "$ref": "#/$defs/count_metric"
        },
        "schema_tokens": {
          "$ref": "#/$defs/count_metric"
        },
        "calls": {
          "$ref": "#/$defs/count_metric"
        }
      }
    },
    "runtime_outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observation_status",
        "outcome",
        "exit_code",
        "evidence_refs",
        "reason"
      ],
      "properties": {
        "observation_status": {
          "enum": ["observed", "missing", "unknown", "stale"]
        },
        "outcome": {
          "enum": ["success", "failure", "partial", "not_run", null]
        },
        "exit_code": {
          "type": ["integer", "null"]
        },
        "evidence_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/evidence_ref"
          }
        },
        "reason": {
          "type": ["string", "null"],
          "minLength": 1
        }
      }
    },
    "eval_verdict": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observation_status",
        "verdict",
        "verdict_ref",
        "evidence_refs",
        "reason"
      ],
      "properties": {
        "observation_status": {
          "enum": ["observed", "missing", "unknown", "stale"]
        },
        "verdict": {
          "type": ["string", "null"],
          "minLength": 1
        },
        "verdict_ref": {
          "oneOf": [
            {
              "$ref": "#/$defs/content_ref"
            },
            {
              "type": "null"
            }
          ]
        },
        "evidence_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/evidence_ref"
          }
        },
        "reason": {
          "type": ["string", "null"],
          "minLength": 1
        }
      }
    },
    "closeout": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observation_status",
        "state",
        "closeout_ref",
        "evidence_refs",
        "reason"
      ],
      "properties": {
        "observation_status": {
          "enum": ["observed", "missing", "unknown", "stale"]
        },
        "state": {
          "enum": ["open", "closed", "not_started", null]
        },
        "closeout_ref": {
          "oneOf": [
            {
              "$ref": "#/$defs/content_ref"
            },
            {
              "type": "null"
            }
          ]
        },
        "evidence_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/evidence_ref"
          }
        },
        "reason": {
          "type": ["string", "null"],
          "minLength": 1
        }
      }
    },
    "owner_acceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observation_status",
        "state",
        "acceptance_ref",
        "evidence_refs",
        "reason"
      ],
      "properties": {
        "observation_status": {
          "enum": ["observed", "missing", "unknown", "stale"]
        },
        "state": {
          "enum": ["accepted", "rejected", "pending", "not_requested", null]
        },
        "acceptance_ref": {
          "oneOf": [
            {
              "$ref": "#/$defs/content_ref"
            },
            {
              "type": "null"
            }
          ]
        },
        "evidence_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/evidence_ref"
          }
        },
        "reason": {
          "type": ["string", "null"],
          "minLength": 1
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_refs", "derivation_ref", "source_revision"],
      "properties": {
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/evidence_ref"
          }
        },
        "derivation_ref": {
          "type": "string",
          "minLength": 1
        },
        "source_revision": {
          "type": ["string", "null"],
          "minLength": 1
        }
      }
    },
    "progress": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "completed", "total"],
      "properties": {
        "state": {
          "enum": ["partial", "terminal"]
        },
        "completed": {
          "type": "integer",
          "minimum": 0
        },
        "total": {
          "type": ["integer", "null"],
          "minimum": 0
        }
      }
    }
  }
}
